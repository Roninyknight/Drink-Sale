.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #fff;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FF5F15;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.action-bar {
  display: flex;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.action-btn {
  padding: 0 30rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.action-btn.primary {
  background: #FF5F15;
  color: #fff;
}

.goods-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.goods-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
}

.goods-title {
  font-size: 28rpx;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-price {
  font-size: 32rpx;
  color: #FF5F15;
  font-weight: bold;
  margin-top: 8rpx;
}

.goods-stock {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.goods-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  margin-top: 4rpx;
}

.goods-status.on {
  color: #07c160;
  background: #e8f8e8;
}

.goods-status.off {
  color: #999;
  background: #f0f0f0;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  margin-left: 16rpx;
}

.btn-edit, .btn-toggle, .btn-delete {
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  text-align: center;
}

.btn-edit {
  background: #e6f3ff;
  color: #1890ff;
}

.btn-toggle {
  background: #fff7e6;
  color: #fa8c16;
}

.btn-delete {
  background: #fff1f0;
  color: #ff4d4f;
}

.loading, .empty {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
